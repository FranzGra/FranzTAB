{
  "manifest_version": 3,
  "name": "FranzTAB",
  "short_name": "FranzTAB",
  "version": "1.0.0",
  "description": "Sostituisce la nuova scheda con una griglia minimale di collegamenti e cartelle, personalizzabile e utilizzabile anche offline.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://www.google.com/s2/favicons*",
    "https://*.gstatic.com/*",
    "https://logo.clearbit.com/*",
    "https://icon.horse/*",
    "https://api.faviconkit.com/*",
    "https://icons.duckduckgo.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
